# Продакшен (docker compose). Скопировать в .env на сервере и заполнить.
# Токен БОЕВОГО бота от @BotFather — не тот, что для разработки.
BOT_TOKEN=123456789:replace-with-production-token

# Пароль PostgreSQL внутри compose (любой длинный случайный: openssl rand -hex 24)
POSTGRES_PASSWORD=replace-with-long-random-password

# Необязательно
# LOG_LEVEL=info

# Бэкапы (deploy/backup.sh)
# BACKUP_DIR=/var/backups/almatn     # локальные копии на VPS
# BACKUP_KEEP_DAYS=14                # сколько дней хранить локально
# RCLONE_REMOTE=offsite:almatn       # куда копировать вне VPS (rclone remote:путь)
