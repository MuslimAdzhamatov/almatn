// Модель данных almatn. Подробности и обоснования — CLAUDE.md, раздел 4.
// Время хранится в UTC; календарные даты плана — @db.Date (локальная дата пользователя).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum NightPolicy {
  keep // присылать по часам как есть
  move // переносить ночные сообщения на nightEnd
}

enum UnitName {
  lines // «строки»
  bayts // «бейты»
  hadiths // «хадисы» — пронумерованные абзацы сборника хадисов
  paragraphs // «абзацы» — прочая проза с номерами абзацев
}

enum ParseStrategy {
  numbers
  text_lines
  image_lines
  paragraphs // пронумерованные абзацы: единица — абзац целиком
  manual_page
  manual_split
}

/**
 * Из чего сделан текст: PDF или присланные картинки (страницы — файлы изображений).
 */
enum SourceKind {
  pdf
  images
}

/**
 * Вид фрагмента единицы: сам текст или заголовок раздела перед ним.
 */
enum FragmentKind {
  text
  heading
}

enum TextStatus {
  parsing
  awaiting_confirm
  ready
  failed
}

enum PaceMode {
  deadline
  per_day
}

enum PlanStatus {
  active
  learning_done
  completed
  cancelled
}

enum PortionStatus {
  sent
  learned
  completed
}

/**
 * Откуда взялась порция: обычная порция заучивания или единицы,
 * которые пользователь знал до плана («Уже знаю») — они только повторяются.
 */
enum PortionKind {
  learning
  known
}

enum ReviewStage {
  learn_reminder
  rep_12h
  rep_1d
  rep_3d
  rep_2w
  rep_1m
}

enum ReviewStatus {
  pending
  sent
  confirmed
  missed
  cancelled
}

enum DeliveryKind {
  portion
  review_batch
  debt_reminder
  learn_reminder
  pause_ending
  autopause
}

enum DeliveryStatus {
  sending
  sent
  confirmed
  missed
  failed
  replaced // порция заменена после «Пропустить»: кнопки этой отправки неактуальны
}

model User {
  id                    BigInt      @id // telegram user id
  username              String?
  timezone              String? // IANA; null до завершения онбординга
  dailySendTime         String? // "HH:mm" — основной слот
  nightStart            String      @default("23:00")
  nightEnd              String      @default("07:00")
  nightPolicy           NightPolicy @default(keep)
  eveningReminderTime   String      @default("21:00")
  learnReminderDelayMin Int         @default(120)
  onboardedAt           DateTime?
  pausedFrom            DateTime?
  pausedUntil           DateTime? // null при pausedFrom != null — пауза до ручного продолжения
  lastActivityAt        DateTime? // последнее нажатие/команда — для автопаузы
  blockedAt             DateTime? // пользователь заблокировал бота (403)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  dialog     DialogState?
  texts      Text[]
  plans      Plan[]
  deliveries Delivery[]
  uploads    UploadFile[]

  @@map("users")
}

model DialogState {
  userId    BigInt   @id
  flow      String // onboarding | upload | plan_create | settings | pause
  step      String
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dialog_states")
}

model Text {
  id               Int            @id @default(autoincrement())
  userId           BigInt
  title            String
  unitName         UnitName       @default(lines)
  sourceKind       SourceKind     @default(pdf)
  originalFileName String
  filePath         String // PDF — файл, картинки — каталог со страницами
  fileSize         Int
  sha256           String
  pageCount        Int
  totalLines       Int            @default(0)
  parseStrategy    ParseStrategy?
  status           TextStatus     @default(parsing)
  parseReport      Json? // аномалии нумерации и т.п. — для сводки
  parseRequest     Json? // выбор пользователя в сводке: стратегия, диапазон страниц, строк со страницы
  parseError       String?
  createdAt        DateTime       @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines      Line[]
  plans      Plan[]
  cropCache  CropCache[]
  deliveries Delivery[]

  @@unique([userId, sha256])
  @@index([userId])
  @@map("texts")
}

/// Единица заучивания: строка, бейт, хадис или абзац. Сам текст не хранится — только положение.
model Line {
  id                 Int     @id @default(autoincrement())
  textId             Int
  lineNumber         Int // итоговый номер по порядку
  printedNumber      Int? // как напечатано в PDF
  page               Int // страница первого фрагмента, с 1
  sectionBreakBefore Boolean @default(false)
  skipped            Boolean @default(false) // пользователь пропустил единицу: не выдаётся и не повторяется

  text      Text           @relation(fields: [textId], references: [id], onDelete: Cascade)
  fragments LineFragment[]

  @@unique([textId, lineNumber])
  @@map("lines")
}

/// Что вырезать со страницы для одной единицы: обычно один фрагмент,
/// у абзаца на нескольких страницах — по фрагменту на страницу, плюс заголовок раздела перед ней.
model LineFragment {
  id      Int          @id @default(autoincrement())
  lineId  Int
  seq     Int // порядок фрагментов внутри единицы, с 0
  kind    FragmentKind @default(text)
  page    Int
  yTop    Float // границы вырезки в пунктах PDF (для картинок — в пикселях страницы)
  yBottom Float
  xLeft   Float? // null — вся ширина страницы
  xRight  Float?

  line Line @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@unique([lineId, seq])
  @@map("line_fragments")
}

/// Присланный файл, который ещё не стал текстом: страницы альбома до кнопки «Готово»
/// и файлы, пришедшие до конца настройки расписания. Хранится file_id, сам файл не скачан.
model UploadFile {
  id           Int      @id @default(autoincrement())
  userId       BigInt
  fileId       String // Telegram file_id
  fileUniqueId String?
  fileName     String
  mimeType     String?
  fileSize     Int?
  mediaGroupId String? // альбом Telegram — страницы одного текста
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("upload_files")
}

model CropCache {
  id             Int      @id @default(autoincrement())
  textId         Int
  cropKey        String // page:yTop:yBottom:width
  telegramFileId String
  createdAt      DateTime @default(now())

  text Text @relation(fields: [textId], references: [id], onDelete: Cascade)

  @@unique([textId, cropKey])
  @@map("crop_cache")
}

// Не больше одного открытого плана (active | learning_done) на текст —
// частичный уникальный индекс plans_one_open_per_text в отдельной SQL-миграции.
model Plan {
  id               Int        @id @default(autoincrement())
  textId           Int
  userId           BigInt
  lineFrom         Int
  lineTo           Int
  unitsPerDay      Int
  paceMode         PaceMode
  startDate        DateTime   @db.Date
  deadlineDate     DateTime?  @db.Date
  deadlineInput    String? // days:N | months:N | date:YYYY-MM-DD
  restDays         Int[] // 0–2 значения, 1 = пн … 7 = вс
  status           PlanStatus @default(active)
  nextLine         Int // первая строка следующей порции
  // «Уже знаю»: единицы, известные до плана — они не выдаются, но повторяются.
  knownFrom        Int?
  knownTo          Int?
  estimatedEndDate DateTime?  @db.Date
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  text     Text      @relation(fields: [textId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  portions Portion[]

  @@index([userId, status])
  @@map("plans")
}

model Portion {
  id          Int           @id @default(autoincrement())
  planId      Int
  seq         Int // 1, 2, 3 … в плане
  lineStart   Int
  lineEnd     Int
  kind        PortionKind   @default(learning)
  status      PortionStatus @default(sent)
  sentAt      DateTime
  learnedAt   DateTime?
  anchorAt    DateTime? // слот, к которому округлено «Выучил»
  completedAt DateTime?

  plan       Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  reviews    Review[]
  deliveries Delivery[]

  @@unique([planId, seq])
  @@index([planId, status])
  @@map("portions")
}

model Review {
  id          Int          @id @default(autoincrement())
  portionId   Int
  stage       ReviewStage
  dueAt       DateTime // логический слот; тихие часы применяются при отправке
  status      ReviewStatus @default(pending)
  sentAt      DateTime?
  confirmedAt DateTime?
  deliveryId  Int? // последняя отправка с этим повтором

  portion  Portion   @relation(fields: [portionId], references: [id], onDelete: Cascade)
  delivery Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

  @@unique([portionId, stage])
  @@index([status, dueAt])
  @@map("reviews")
}

model Delivery {
  id               Int            @id @default(autoincrement())
  userId           BigInt
  textId           Int?
  portionId        Int? // для kind = portion | learn_reminder
  kind             DeliveryKind
  slotAt           DateTime
  dedupeKey        String         @unique // защита от повторной отправки того же слота
  status           DeliveryStatus @default(sending) // запись создаётся до отправки
  sentAt           DateTime?
  answeredAt       DateTime?
  messageIds       Int[] // все сообщения: альбомы + сообщение с кнопками
  buttonsMessageId Int? // для editMessageReplyMarkup
  cropMarginSteps  Int            @default(0) // «Захватить больше»: сколько раз расширяли вырезку
  extraBefore      Int            @default(0) // «Ещё выше»: сколько соседних единиц уже прислано
  extraAfter       Int            @default(0) // «Ещё ниже»

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text    Text?    @relation(fields: [textId], references: [id], onDelete: Cascade)
  portion Portion? @relation(fields: [portionId], references: [id], onDelete: Cascade)
  reviews Review[]

  @@index([userId, kind, slotAt])
  @@map("deliveries")
}
